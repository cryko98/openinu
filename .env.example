# fal.ai API key — required for the live OpenINU chat.
# Get one at https://fal.ai/dashboard/keys, then add it on Vercel:
# Project → Settings → Environment Variables → FAL_KEY
FAL_KEY=

# Optional: which model fal.ai/any-llm should run.
# e.g. google/gemini-2.5-flash, anthropic/claude-sonnet-4.5, openai/gpt-4o-mini
FAL_MODEL=google/gemini-2.5-flash

# Optional: a private Solana RPC for the live token stats bar.
# Defaults to the public mainnet endpoint, which is rate limited.
SOLANA_RPC_URL=
